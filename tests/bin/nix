#!/usr/bin/env bash
# Stub of nix for tests of the tools step. Every call is appended to $CALLS.
#
# - "config show system" prints $FIXTURES/nix-system.
# - "eval --raw --file FILE SYSTEM.NAME" prints $FIXTURES/nix-eval-SYSTEM.NAME,
#   the store path that FILE records, and fails like nix when it is missing.
# - "build --no-link --print-out-paths PATH" prints the lines of
#   $FIXTURES/nix-build-BASENAME, BASENAME that of PATH, and fails like nix
#   when it is missing, as when no substituter has PATH.
#
# Other commands and flags are not supported. The stub uses builtins only: it
# runs with the PATH of the runner.
set -euo pipefail

readonly EVAL_FLAGS='--raw --file'
readonly BUILD_FLAGS='--no-link --print-out-paths'

# stub_error MESSAGE: fail as the stub, not as Nix.
stub_error() {
  echo "stub nix: $1" >&2
  exit 2
}

# print_fixture FILE MESSAGE: print the lines of FILE, or fail as nix with
# MESSAGE when it is missing.
print_fixture() {
  local file=$1 message=$2 line
  if [[ ! -f $file ]]; then
    echo "error: $message" >&2
    exit 1
  fi
  while IFS= read -r line; do printf '%s\n' "$line"; done <"$file"
}

# system: print the system of nix.
system() {
  [[ "$*" == 'config show system' ]] || stub_error "unsupported: $*"
  print_fixture "$FIXTURES/nix-system" "no system"
}

# eval_raw FLAGS FILE ATTRIBUTE: print the value of ATTRIBUTE, without a newline
# as --raw does.
eval_raw() {
  [[ "${*:2:2}" == "$EVAL_FLAGS" && $# == 5 ]] || stub_error "eval without $EVAL_FLAGS FILE ATTRIBUTE: $*"
  local attribute=$5 value
  value=$(print_fixture "$FIXTURES/nix-eval-$attribute" "attribute '$attribute' not found")
  printf '%s' "$value"
}

# build FLAGS PATH: print the paths that substituting PATH yields.
build() {
  [[ "${*:2:2}" == "$BUILD_FLAGS" && $# == 4 ]] || stub_error "build without $BUILD_FLAGS PATH: $*"
  local path=$4
  print_fixture "$FIXTURES/nix-build-${path##*/}" "path '$path' is required, but there is no substituter that can build it"
}

echo "nix $*" >>"$CALLS"
case ${1-} in
  config) system "$@" ;;
  eval) eval_raw "$@" ;;
  build) build "$@" ;;
  *) stub_error "unsupported: $*" ;;
esac
