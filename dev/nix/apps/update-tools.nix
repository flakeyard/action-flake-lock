# `nix run ./dev#update-tools`: writes tools.nix, the store paths of the
# packages of the root flake, in the current directory, the root of the
# repository.
{
  perSystem =
    {
      pkgs,
      lib,
      toolPaths,
      ...
    }:
    let
      unformatted = pkgs.writeText "tools.nix" ''
        # The store path of every package of the root flake, which the action
        # substitutes from the binary cache (ADR-0003). Generated by
        # `nix run ./dev#update-tools`; do not edit.
        ${lib.generators.toPretty { } toolPaths}
      '';
      formatted = pkgs.runCommand "tools.nix" { nativeBuildInputs = [ pkgs.nixfmt ]; } ''
        nixfmt <${unformatted} >$out
      '';
      script = pkgs.writeShellApplication {
        name = "update-tools";
        text = ''
          if [[ ! -f dev/flake.nix ]]; then
            echo "update-tools: run it in the root of the repository." >&2
            exit 1
          fi
          cp --no-preserve=mode -- ${formatted} tools.nix
        '';
      };
    in
    {
      apps.update-tools = {
        type = "app";
        program = "${script}/bin/update-tools";
        meta.description = "Writes tools.nix from the packages of the root flake";
      };
    };
}
